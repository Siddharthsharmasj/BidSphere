# Set these in Vercel Project Settings > Environment Variables.
DJANGO_SECRET_KEY=replace-with-a-unique-long-random-secret
DJANGO_DEBUG=0
DJANGO_SECURE_HSTS_SECONDS=31536000
# Set to 1 only when every subdomain is HTTPS-only.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0
DJANGO_ALLOWED_HOSTS=.vercel.app
DJANGO_PRIMARY_DOMAIN=
# DATABASE_URL is supplied by your PostgreSQL provider integration.

# Recommended for persistent auction/product images on Vercel:
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_ADDRESSING_STYLE=auto
AWS_QUERYSTRING_AUTH=0
CRON_SECRET=replace-with-a-long-random-secret-for-scheduled-settlement
